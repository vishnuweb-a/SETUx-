# Backend (server-only). Copy to backend/.env — never commit the real file.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Supabase server credentials (wired up in Phase 2).
# SUPABASE_SERVICE_ROLE_KEY is privileged and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
