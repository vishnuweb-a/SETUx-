# Frontend (browser). Copy to frontend/.env — never commit the real file.
# Every VITE_* value is shipped to the browser and is therefore PUBLIC.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Supabase browser credentials (public; protected by Row Level Security).
# Never place SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
