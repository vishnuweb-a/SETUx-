# =============================================================================
# SetuX — Environment Variable Reference
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Two trust boundaries exist in this repository:
#
#   backend/  → server-only. May hold privileged secrets.
#   frontend/ → shipped to the browser. VITE_* values are PUBLIC.
#
# SUPABASE_SERVICE_ROLE_KEY must NEVER appear with a VITE_ prefix and must
# NEVER be referenced from frontend/ source code.
# =============================================================================

# ----------------------------- Backend (server) ------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Supabase project (server-side credentials)
# Required: the backend refuses to start without these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------- Frontend (browser) -----------------------------
# Only browser-safe values belong here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
